rules_version = '2';

// ---------------------------------------------------------------------------
// Bokgoni Tech — Cloud Storage security rules
// ---------------------------------------------------------------------------

service firebase.storage {
  match /b/{bucket}/o {

    function isStaff() {
      return request.auth != null;
    }

    // Changelog screenshots — public can VIEW, only staff upload.
    match /changelog/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Repair-era activity images. Kept readable so existing published entries
    // do not break; nothing writes here any more.
    match /activity/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Repair-era request photos. The pilot form no longer uploads files, so
    // this is staff-read only and closed to writes.
    match /requests/{allPaths=**} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
