# ---------------------------------------------------------------------------
# Bokgoni Tech — Firebase configuration
# ---------------------------------------------------------------------------
# 1. Go to https://console.firebase.google.com and create a project.
# 2. Add a "Web app" to the project (the </> icon).
# 3. Copy the config values from "SDK setup and configuration".
# 4. Copy this file to ".env.local" and paste your real values below.
#    (.env.local is git-ignored so your keys stay private.)
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx

# Public contact details shown on the site (optional — sensible defaults used if blank)
VITE_CONTACT_WHATSAPP=27000000000
VITE_CONTACT_EMAIL=hello@bokgonitech.co.za
VITE_CONTACT_PHONE=+27 00 000 0000
VITE_CONTACT_LOCATION=Pretoria, South Africa
