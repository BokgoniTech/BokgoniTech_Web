rules_version = '2';

// ---------------------------------------------------------------------------
// Bokgoni Tech — Firestore security rules
// ---------------------------------------------------------------------------
// Principle: the public can ONLY read published changelog entries and SUBMIT
// pilot requests. Everything internal (contact details, all request reads,
// staff records) requires an authenticated staff account.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // True if the request comes from a signed-in user that has a staff record.
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    // ---- Changelog --------------------------------------------------------
    // Still named `activityLog`: it was the repair-era activity log, and
    // renaming the collection would orphan anything already written.
    // Public can read entries flagged isPublic == true.
    // Staff can read everything and write.
    match /activityLog/{docId} {
      allow read: if resource.data.isPublic == true || isStaff();
      allow create, update, delete: if isStaff();
    }

    // ---- Pilot requests ---------------------------------------------------
    // Anyone may CREATE a request (the public pilot form). Only staff may read,
    // update or delete them — protects enquirer contact details.
    match /requests/{docId} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }

    // ---- Staff records ----------------------------------------------------
    // A signed-in user may read their own record (to load their role/name).
    // Creating/editing staff is done in the Firebase console (or by an admin
    // function), never from the client.
    match /staff/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Default deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
